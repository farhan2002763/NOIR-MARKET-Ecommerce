# Optional for local testing: default uses LOCAL DEMO payment, no money or Stripe account needed.
PORT=3002
# Set a long random JWT secret for anything beyond isolated local testing:
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_32_PLUS_CHARACTER_SECRET
# Optional Stripe TEST mode only (never a live key):
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# BASE_URL=http://127.0.0.1:3002
